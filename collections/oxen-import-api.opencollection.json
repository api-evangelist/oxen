{
  "opencollection": "1.0.0",
  "info": {
    "name": "oxen Ai Import API",
    "version": "0.243.1"
  },
  "items": [
    {
      "info": {
        "name": "Import",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Import file from URL",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/import/:resource",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "Common-Crawl",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "resource",
                "value": "main/data",
                "type": "path",
                "description": "Destination path (including branch)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Import a file from a remote URL and commit it to the repository."
        },
        {
          "info": {
            "name": "Upload zip archive",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/import/upload/:resource",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "Wiki-Text",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "resource",
                "value": "main/archive",
                "type": "path",
                "description": "Destination path (including branch)"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Upload and decompress a zip archive into the repository and commit the contents."
        }
      ]
    }
  ],
  "bundled": true
}