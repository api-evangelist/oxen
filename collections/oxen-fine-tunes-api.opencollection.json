{
  "opencollection": "1.0.0",
  "info": {
    "name": "oxen Ai fine_tunes API",
    "version": "0.243.1"
  },
  "items": [
    {
      "info": {
        "name": "fine_tunes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List fine-tunes for an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/orgs/:name/fine_tunes",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Organization name"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-indexed)"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search across fine-tune name, display name, base model, and repository (case-insensitive substring match). For example: 'qwen', 'ox/Delorean', 'customer-support'."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by status. One of: created, tokenizing, enqueued, running, completed, stopped, errored, deployed"
              },
              {
                "name": "created_by",
                "value": "",
                "type": "query",
                "description": "Filter by creator username (exact match)"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort order by creation date: 'newest' (default) or 'oldest'"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return all fine-tune jobs in repositories belonging to the given organization. Requires the authenticated user to be a member of the organization."
        },
