{
  "opencollection": "1.0.0",
  "info": {
    "name": "oxen Ai Commits API",
    "version": "0.243.1"
  },
  "items": [
    {
      "info": {
        "name": "Commits",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload commits DB",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/upload",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "Upload the commits database tarball to the server during push."
        },
        {
          "info": {
            "name": "Download commits DB",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits_db",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "Download the commits database as a compressed tarball for cloning."
        },
        {
          "info": {
            "name": "Upload data chunk",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/upload_chunk",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "hash",
                "value": "a2c3d4e5f67890b1c2d3e4f5a6b7c8d9",
                "type": "path"
              },
              {
                "name": "chunk_num",
                "value": "1",
                "type": "path"
              },
              {
                "name": "total_chunks",
                "value": "10",
                "type": "path"
              },
              {
                "name": "total_size",
                "value": "100000000",
                "type": "path"
              },
              {
                "name": "is_compressed",
                "value": "true",
                "type": "path"
              },
              {
                "name": "filename",
                "value": "images/cow.jpg",
                "type": "path"
              }
            ]
          },
          "docs": "Upload a chunk of file data for use in large file uploads."
        },
        {
          "info": {
            "name": "Notify upload complete",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/:commit_id/complete",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "commit_id",
                "value": "84c76a5b2e9a2637f9091991475c404d",
                "type": "path",
                "description": "ID of the commit to complete"
              }
            ]
          },
          "docs": "Notify the server that the commit has finished uploading."
        },
        {
          "info": {
            "name": "Mark commits as synced",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/mark_commits_as_synced",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "DEPRECATED - This operation is a no-op that echoes the hashes from the request, and will be removed in a future release."
        },
        {
          "info": {
            "name": "Get root commit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/root",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "Get the root (initial) commit of the repository, or None if empty."
        },
        {
          "info": {
            "name": "Get commit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/:commit_id",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "commit_id",
                "value": "84c76a5b2e9a2637f9091991475c404d",
                "type": "path",
                "description": "Hash ID of the commit"
              }
            ]
          },
          "docs": "Get details of a specific commit by its ID."
        },
        {
          "info": {
            "name": "Download commit entries DB",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/:commit_or_branch/commit_entries_db",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "commit_or_branch",
                "value": "main",
                "type": "path",
                "description": "Commit ID or Branch name"
              }
            ]
          },
          "docs": "Download the commit entries database for a specific commit as a tarball."
        },
        {
          "info": {
            "name": "List commits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "List all commits in the repository's history."
        },
        {
          "info": {
            "name": "Upload commit",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload a commit to a branch on the server. This creates an empty commit. To create a commit with children, use the upload_tree endpoint."
        },
        {
          "info": {
            "name": "List commit history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/history/:resource",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "resource",
                "value": "main/data/train/image.jpg",
                "type": "path",
                "description": "Commit ID, Branch name, or path to a file/directory"
              },
              {
                "name": "page",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List paginated commit history for a revision or file path. Supports revision ranges (base..head) and path-specific history."
        },
        {
          "info": {
            "name": "List missing commits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/missing",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "From a list of commit hashes, list the ones not present on the server"
        },
        {
          "info": {
            "name": "List missing files from commits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/missing_files",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "base",
                "value": "abc1234567890def1234567890fedcba",
                "type": "path"
              },
              {
                "name": "head",
                "value": "84c76a5b2e9a2637f9091991475c404d",
                "type": "path"
              }
            ]
          },
          "docs": "List files that are referenced in a commit but not present on the server. Accept a commit range."
        },
        {
          "info": {
            "name": "Upload commit tree",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/:commit_id/upload_tree",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "commit_id",
                "value": "84c76a5b2e9a2637f9091991475c404d",
                "type": "path",
                "description": "Client head commit ID"
              }
            ]
          },
          "docs": "Upload a commit's merkle tree data as a compressed tarball."
        },
        {
          "info": {
            "name": "List all commits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/all",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "page",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all commits in a repository"
        },
        {
          "info": {
            "name": "Download dir hashes DB",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/:base_head/dir_hashes_db",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "base_head",
                "value": "abc1234..84c76a5",
                "type": "path",
                "description": "Commit ID range (base..head) or single commit ID"
              }
            ]
          },
          "docs": "Download directory hashes database for a commit range as a tarball."
        },
        {
          "info": {
            "name": "List commits between two revisions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/compare/:base_head/commits",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "satellite-images",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "base_head",
                "value": "main..feature/add-labels",
                "type": "path",
                "description": "The base and head revisions separated by '..'"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (starts at 1)"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Page size for pagination"
              }
            ]
          },
          "docs": "List commits between a 'base' and 'head' commit."
        },
        {
          "info": {
            "name": "Get a commit's parents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/commits/:commit_or_branch/parents",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "commit_or_branch",
                "value": "main",
                "type": "path",
                "description": "Commit ID or Branch name"
              }
            ]
          },
          "docs": "Get the parent commits of a specific commit or the tip of a branch."
        }
      ]
    }
  ],
  "bundled": true
}