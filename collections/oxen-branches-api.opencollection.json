{
  "opencollection": "1.0.0",
  "info": {
    "name": "oxen Ai Branches API",
    "version": "0.243.1"
  },
  "items": [
    {
      "info": {
        "name": "Branches",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Merge a commit into a branch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/branches/:branch_name/merge",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "branch_name",
                "value": "main",
                "type": "path",
                "description": "Name of the branch to merge into (the target branch)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Merge a client commit into a branch during push. Returns merge commit on success, or original server commit if conflicts occur."
        },
        {
          "info": {
            "name": "Get an existing branch",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/branches/:branch_name",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "branch_name",
                "value": "main",
                "type": "path",
                "description": "Name of the branch"
              }
            ]
          },
          "docs": "Get a branch by name, returning its details and current commit."
        },
        {
          "info": {
            "name": "Update a branch to a new commit",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/branches/:branch_name",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "branch_name",
                "value": "main",
                "type": "path",
                "description": "Name of the branch to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a branch to point to a different commit ID."
        },
        {
          "info": {
            "name": "Delete a branch",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/branches/:branch_name",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "branch_name",
                "value": "development",
                "type": "path",
                "description": "Name of the branch to delete"
              }
            ]
          },
          "docs": "Force delete a branch by name."
        },
        {
          "info": {
            "name": "Get all versions of a file on a branch",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/branches/:branch_name/versions/:path",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              },
              {
                "name": "branch_name",
                "value": "main",
                "type": "path",
                "description": "Name of the branch"
              },
              {
                "name": "path",
                "value": "images/train.jpg",
                "type": "path",
                "description": "Path to the file or dir"
              },
              {
                "name": "page",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List paginated historical versions of a file across commits on a branch, including schema hash for tabular files."
        },
        {
          "info": {
            "name": "List all branches",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/branches",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "List all branches in the repository with their current commit information."
        },
        {
          "info": {
            "name": "Create a new branch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/branches",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new branch from another branch name or commit ID. Returns existing branch if name already exists."
        }
      ]
    }
  ],
  "bundled": true
}