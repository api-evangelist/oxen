{
  "opencollection": "1.0.0",
  "info": {
    "name": "oxen Ai Repositories API",
    "version": "0.243.1"
  },
  "items": [
    {
      "info": {
        "name": "Repositories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get repository stats",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/stats",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "Get the total number of files, the total size of the files, and the number of different file types."
        },
        {
          "info": {
            "name": "List repositories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace to list repositories from"
              }
            ]
          },
          "docs": "List all repositories in a namespace."
        },
        {
          "info": {
            "name": "Transfer repository namespace",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/transfer",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Current namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "Cat-Dog-Classifier",
                "type": "path",
                "description": "Name of the repository"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Transfer a repository to a different namespace."
        },
        {
          "info": {
            "name": "Get repository size",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/size",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "Get the cached size of the repository in bytes."
        },
        {
          "info": {
            "name": "Update repository size",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name/size",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "Recalculate and update the cached repository size."
        },
        {
          "info": {
            "name": "Get repository details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "ImageNet-1k",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "Get repository details including size and data types from the main branch."
        },
        {
          "info": {
            "name": "Delete repository",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://hub.oxen.ai/api/repos/:namespace/:repo_name",
            "params": [
              {
                "name": "namespace",
                "value": "ox",
                "type": "path",
                "description": "Namespace of the repository"
              },
              {
                "name": "repo_name",
                "value": "Cat-Dog-Classifier",
                "type": "path",
                "description": "Name of the repository"
              }
            ]
          },
          "docs": "Delete a repository. Deletion runs in the background."
        },
        {
          "info": {
            "name": "Create repository",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://hub.oxen.ai/api/repos",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new repository, optionally with initial files via JSON or multipart form."
        }
      ]
    }
  ],
  "bundled": true
}